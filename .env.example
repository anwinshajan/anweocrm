# ANWEO CRM — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# Option A: Google Apps Script Web App (Recommended — Zero IAM / Zero Google Cloud Setup)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Option B: Google Sheets Service Account (Alternative)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_BACKUP_SHEET_ID=your-backup-sheet-id-here

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-3-5-haiku-20241022

# Auth
SESSION_SECRET=your-random-secret-minimum-32-characters-here

# Cron (for Vercel cron jobs)
CRON_SECRET=your-random-cron-secret-here
